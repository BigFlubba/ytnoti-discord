# Copy to .env and fill in. Never commit .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Optional but recommended for reliable live-stream detection:
# YOUTUBE_API_KEY=
# Optional: fixed HMAC secret so signatures stay valid across restarts
# YTNOTI_SECRET=
# Optional: also write logs to a rotating file (use with `log_file: ${YTNOTI_LOG_FILE:-}`)
# YTNOTI_LOG_FILE=/data/logs/ytnoti-discord.log
# Optional: send sample notifications at startup (true | false | upload,live,...)
# YTNOTI_TEST_ON_START=true
