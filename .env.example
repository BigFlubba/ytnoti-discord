# ytnoti-discord environment variables.
# List of commonly used variables and secrets for the service. These are used in config.yaml, but can also be set in the environment.
# All advanced options are available in config.yaml, but this file is easier to edit for most users.
# Users can skip this file and edit config.yaml directly if they prefer.
# All edits require a restart to take effect.
# DO NOT SHARE THIS FILE!

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# Required: Callback URL for the service to send notifications to.
# This must be a public URL that YouTube can reach. If you are running behind a reverse proxy,
# make sure to forward the request to the internal port where this service is running.
# Example: https://yt.example.com/ytnoti "/" also works.
CALLBACK_URL=

# Required: Discord webhook URL for the default destination.
# Create one in Discord: Edit Channel > Integrations > Webhooks.
# Keep the real URL private; anyone with it can post to that channel.
# Example: https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz
MAIN_DISCORD_WEBHOOK_URL=

# Required: Your timezone. Used for formatting timestamps.
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones for valid values
TZ=UTC

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# Optional: Additional Discord webhook URL for the default destination.
# Create one in Discord: Edit Channel > Integrations > Webhooks.
# Keep the real URL private; anyone with it can post to that channel.
# Example: https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz
# DISCORD_ALERTS_WEBHOOK_URL=

# Optional: YouTube Data API v3 key. Improves live/upcoming detection.
# Without it, the service tries to detect stream state from the public watch page.
# YOUTUBE_API_KEY=

# Optional: fixed HMAC secret for stable webhook signatures across restarts.
# If unset, a random secret is generated at startup.
# YTNOTI_SECRET=

# Optional: log level for console output. Defaults to INFO. Supported values: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# Optional: write rotating logs to a file in addition to console logs.
# Relative paths are under data_dir (/data in Docker).
# Example: /data/logs/ytnoti-discord.log
# YTNOTI_LOG_FILE=/data/logs/ytnoti-discord.log

# Optional: Discord webhook display name and avatar.
# USERNAME=YouTube Notifications
# Example: https://example.com/avatar.png
# AVATAR_URL=

# @everyone and @here are blocked by default. To allow them, uncomment:
# allowed_mentions:
#   parse: [everyone, roles, users]

# Optional: send sample notifications on each startup.
# Accepted values: true, false, or a comma-separated event list (e.g. upload,live).
# Disable after testing to avoid repeat messages on every restart.
# YTNOTI_TEST_ON_START=false

# Validate configuration and exit without starting the server.
# CHECK_ONLY=false